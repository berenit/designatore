# Variabili usate da docker-compose.yml (non sostituiscono il .env di Laravel)
APP_PORT=8080
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_PORT=3306
REDIS_PORT=6379
UID=1000
GID=1000

# Nginx Proxy Manager (reverse proxy con Let's Encrypt)
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_ADMIN_PORT=81
